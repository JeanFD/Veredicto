(seguranca) {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }
}

veredicto.duckdns.org {
    import seguranca
    encode gzip
    reverse_proxy veredicto:8000
}

despertar-das-raizes.duckdns.org {
    encode gzip
    reverse_proxy host.docker.internal:8080
}

vibemetrics.duckdns.org {
    encode gzip
    reverse_proxy vibemetrics:5000
}